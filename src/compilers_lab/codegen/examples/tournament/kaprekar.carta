hola, rutina_kaprekar {
    entero n = 3524
    entero iteraciones = 0
    mientras (n != 6174 && n != 0) {
        entero d0 = n % 10
        entero d1 = (n / 10) % 10
        entero d2 = (n / 100) % 10
        entero d3 = (n / 1000) % 10
        entero tmp = 0
        cuando (d0 > d1) { tmp = d0  d0 = d1  d1 = tmp }
        cuando (d2 > d3) { tmp = d2  d2 = d3  d3 = tmp }
        cuando (d0 > d2) { tmp = d0  d0 = d2  d2 = tmp }
        cuando (d1 > d3) { tmp = d1  d1 = d3  d3 = tmp }
        cuando (d1 > d2) { tmp = d1  d1 = d2  d2 = tmp }
        entero mayor = d3 * 1000 + d2 * 100 + d1 * 10 + d0
        entero menor = d0 * 1000 + d1 * 100 + d2 * 10 + d3
        n = mayor - menor
        iteraciones = iteraciones + 1
    }
    muestra("Iteraciones hasta 6174:")
    muestra(iteraciones)
}
atentamente, sofia
