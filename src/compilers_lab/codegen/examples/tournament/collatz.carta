hola, collatz {
    entero n
    muestra("Ingresa n:")
    lee(n)
    entero pasos = 0
    mientras (n != 1) {
        cuando (n % 2 == 0) {
            n = n / 2
        } sino {
            n = 3 * n + 1
        }
        pasos = pasos + 1
    }
    muestra("Pasos de Collatz:")
    muestra(pasos)
}
atentamente, sofia
